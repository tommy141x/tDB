{
  "name": "tdb",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Database resource for FiveM: a drop-in oxmysql replacement backed by PocketBase, with realtime and collection APIs on top",
  "scripts": {
    "secrets:check": "bun run ../tLib/scripts/secret-gate.ts",
    "secrets:install-hooks": "bun run ../tLib/scripts/secret-gate.ts --install-hooks",
    "secrets:check-hooks": "bun run ../tLib/scripts/secret-gate.ts --check-hooks",
    "setup": "bun run secrets:install-hooks && bun install && bun run runtime",
    "runtime": "bun scripts/fetch-runtime.ts",
    "prod": "bun scripts/fetch-runtime.ts --all && bun scripts/prod.ts",
    "test": "bun scripts/run-tests.ts",
    "thumb": "bun scripts/thumb.ts",
    "docs:check": "bun scripts/check-docs.mjs",
    "verify": "bun run secrets:check && bun run lint && bun run test && bun run docs:check",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
