node_modules/

# Generated output. One root, so a new build artifact never needs a new rule
# here and can never reach a release by being forgotten.
.build/

# Fetched at setup, never authored. The PocketBase release binaries live here
# and are reproducible from a pinned version + checksum, so they have no
# business in history.
.runtime/

# PocketBase's own state. pb_data is a live database, pb_migrations is
# generated from it.
pb_data/
pb_migrations/

# Scratch, stale copies and backups.
*.backup
*.bak
*.old
*.log
