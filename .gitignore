node_modules/
.build/

# Fetched at setup from a pinned version + checksum.
.runtime/

# PocketBase's own state.
pb_data/
pb_migrations/

__pycache__/

*.backup
*.bak
*.old
*.log

# Real credentials, including the superuser password tDB generates on first
# start. Never committed, never packaged. The tracked config.lua holds blanks
# permanently and server/utils/config-loader.js overlays this file onto it.
# Precedence matches the estate: convar > config.local.lua > config.lua.
config.local.lua
config/config.local.lua

# `bun run gallery` captures and the `bun run thumb` composite built from them.
# Regenerated on demand and consumed by the store page in tWeb, not by anything
# here. banner.jpg is the exception and IS tracked: README.md shows it.
assets/hero/
# docs/public/thumb.jpg   <- un-ignored 2026-10-17, see note below

# ⚠️ NOT the storefront thumbnail. It is referenced by docs/product.mdx, so it
# has to be in the repo: tWeb's sync copies from a CHECKOUT, and a file only
# this machine has reaches the site once and then never updates again. That is
# how a regenerated thumbnail silently keeps serving the old art.

# The sql/ drop folder is the OPERATOR's, and anything in it is applied to their
# database at startup. A .sql committed here ships to every customer and runs on
# their server: `sql/01-lb-phone.sql` did exactly that, 75 CREATE TABLEs of a paid
# third-party schema, until 2026-10-23. Only the README belongs in git.
sql/*
!sql/README.md
