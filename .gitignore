node_modules/
.build/

# Fetched at setup from a pinned version + checksum.
.runtime/

# PocketBase's own state.
pb_data/
pb_migrations/

__pycache__/

*.backup
*.bak
*.old
*.log

# The operator's copy, created from config.example.lua on first run. tDB writes
# the generated superuser password into it, so it must never be tracked.
config.lua

# The developer's real credentials. Never committed, never packaged.
# The tracked config.lua holds blanks permanently; tlib.secrets overlays this
# file onto Config at server start. See tLib/shared/imports/secrets/server.lua.
config.local.lua
config/config.local.lua
